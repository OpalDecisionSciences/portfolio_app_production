# Unified Django Application Dockerfile
# Environment-driven configuration for both development and production
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set work directory
WORKDIR /app

# Install system dependencies including GDAL for GeoDjango
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client \
        build-essential \
        libpq-dev \
        wget \
        curl \
        unzip \
        gnupg \
        ca-certificates \
        chromium \
        chromium-driver \
        gdal-bin \
        libgdal-dev \
        python3-gdal \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for Chromium
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Set GDAL environment variables for GeoDjango
ENV GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
ENV GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so

# Create app user for security (production best practice)
# Use consistent UID/GID (1000) to match common host user permissions
RUN groupadd -r -g 1000 appuser && useradd -r -u 1000 -g appuser appuser

# Install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install gunicorn==21.2.0

# Copy project files
COPY ./django_app/src /app/
COPY ./shared /shared/
COPY ./data_pipeline /data_pipeline/

# Add shared modules to Python path
ENV PYTHONPATH="/app:/shared/src:/data_pipeline/src:$PYTHONPATH"

# Create necessary directories and set permissions
RUN mkdir -p /app/media /app/staticfiles /app/logs /app/state /app/output \
    && chown -R appuser:appuser /app /shared /data_pipeline

# Copy unified entrypoint script
COPY ./docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chown appuser:appuser /app/entrypoint.sh

# Switch to non-root user for security
USER appuser

# Expose port
EXPOSE 8000

# Environment-aware health check
# Development: shorter start period, Production: longer for migrations
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Use unified entrypoint script
CMD ["/app/entrypoint.sh"]