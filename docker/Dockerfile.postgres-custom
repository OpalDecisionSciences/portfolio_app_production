# Custom PostgreSQL with pgvector + PostGIS extensions
# Maintains existing pgvector compatibility while adding PostGIS support
FROM pgvector/pgvector:pg15

# Install PostGIS extension packages
# Uses official PostgreSQL 15 PostGIS packages for stability
RUN apt-get update && apt-get install -y \
    postgresql-15-postgis-3 \
    postgresql-15-postgis-3-scripts \
    postgis \
    && rm -rf /var/lib/apt/lists/*

# Add PostGIS utilities to PATH for convenience
ENV PATH="/usr/lib/postgresql/15/bin:$PATH"

# Verify installations are compatible
RUN echo "PostGIS installed alongside pgvector for PostgreSQL 15"