FROM nginx:stable

# Install dependencies for SSL management and health checks
RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    openssl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy nginx configurations (HTTP and HTTPS modes)
COPY ./nginx.http.conf /etc/nginx/nginx.http.conf
COPY ./nginx.prod.conf /etc/nginx/nginx.prod.conf

# Copy SSL management and wait scripts
COPY ./nginx-ssl-manager.sh /usr/local/bin/nginx-ssl-manager
COPY ./wait-for-it.sh /wait-for-it.sh
RUN chmod +x /usr/local/bin/nginx-ssl-manager /wait-for-it.sh

# Create necessary directories
RUN mkdir -p /var/www/certbot /etc/letsencrypt/live

# Expose ports
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health/ || exit 1

# Use industry-standard SSL certificate management
CMD ["/wait-for-it.sh", "web:8000", "--", "/wait-for-it.sh", "rag:8001", "--", "nginx-ssl-manager", "init"]