def setup_test_paths(verbose: bool = False) -> List[str]:
    """
    Set up paths for test scripts.
    """
    project_root = get_project_root()
    added_paths = []
    
    paths_to_add = [
        project_root / 'shared' / 'src',
        project_root / 'django_app' / 'src',
        project_root / 'data_pipeline' / 'src',
        project_root / 'rag_service' / 'src',
        project_root / 'tests',
    ]
    
    for path in paths_to_add:
        path_str = str(path)
        if path.exists() and path_str not in _paths_added:
            if path_str not in sys.path:
                sys.path.insert(0, path_str)
                added_paths.append(path_str)
                if verbose:
                    print(f"Added test path: {path_str}")
            
            _paths_added.add(path_str)
    
    return added_paths

# Auto-setup when imported (can be disabled with DISABLE_AUTO_PATH_SETUP env var)
if not os.getenv('DISABLE_AUTO_PATH_SETUP'):
    setup_all_paths()