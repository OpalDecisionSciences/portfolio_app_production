# Staging Environment Configuration
# Copy to .env.staging and update values

# Environment
ENVIRONMENT=staging
DEBUG=True

# Database
DATABASE_NAME=portfolio_staging
DATABASE_USER=portfolio_user
DATABASE_PASSWORD=staging_secure_password_change_me
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Django
SECRET_KEY=staging_secret_key_change_me_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,staging.opaldecisionsciences.com

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=michelin-static-files-staging
AWS_MEDIA_BUCKET_NAME=michelin-media-files-staging
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=michelin-static-files-staging.s3.amazonaws.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Domain
DOMAIN_NAME=staging.opaldecisionsciences.com
ACME_EMAIL=staging@opaldecisionsciences.com

# Feature Flags
ENABLE_S3_DIRECT_IMAGES=false
ENABLE_AB_TESTING=true

# Logging
LOG_LEVEL=DEBUG
S3_LOGGING_BUCKET=portfolio-staging-logs
S3_LOGGING_PREFIX=staging/