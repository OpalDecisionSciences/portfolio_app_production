# Environment files
.env
.env.local
.env.production
.env.prod

# Don't ignore example files (they should have placeholders only)
# .env.example
# .env.prod.example
.env.prod

# Django generated static files (collected at runtime)
# Source static files (django_app/src/static/) stay in git
django_app/src/staticfiles/

# Production logs (runtime generated)
production_logs/
*.log

# SSL certificates and private keys (NEVER commit these)
ssl/live/
ssl/archive/
ssl/accounts/
ssl/renewal/
ssl/renewal-hooks/

# SSL configuration files (these are safe to commit)
# ssl/options-ssl-nginx.conf
# ssl/ssl-dhparams.pem
