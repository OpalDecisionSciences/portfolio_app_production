# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration - Django naming convention
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=portfolio_db
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Legacy Docker naming (for backwards compatibility)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Google Maps API (for geographic search functionality)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# RAG Service
RAG_SERVICE_URL=http://localhost:8001

# Application Settings
PORTFOLIO_DATA_DIR=/app/data
PORTFOLIO_SCRAPING_BATCH_SIZE=10
PORTFOLIO_TOKEN_MANAGEMENT_DIR=/app/token_management

# Web Scraping Configuration
CHROMEDRIVER_PATH=/usr/bin/chromedriver
CHROME_BIN=/usr/bin/chromium

# Logging
LOG_LEVEL=INFO

# Media and Static Files
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# AWS S3 Configuration (for production static files)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name-static
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
USE_S3_STATIC=False

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Sentry (optional, for error tracking)
SENTRY_DSN=your-sentry-dsn-here

# Security (for production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Admin Panel Security - IP Whitelist  
# Individual IP configuration for clean management
# Replace these with your actual IP addresses
ADMIN_USER_IP=your-current-ip-address
ADMIN_SERVER_IP=your-production-server-ip
ADMIN_DOCKER_NETWORK=172.16.0.0/12
ADMIN_LOCALHOST=127.0.0.1